{
  "manifest_version": 3,
  "name": "APEX SENTINEL",
  "version": "1.1.0",
  "description": "APEX SENTINEL is a local-first AI browser protection assistant for inspecting security context, privacy risks, suspicious links, pop-ups, and downloads.",
  "author": "Rahmann Manzar El Herman",
  "homepage_url": "https://apexlifeglobal.com",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "APEX SENTINEL"
  },
  "background": {
    "service_worker": "background.js"
  },
  "sidebar_action": {
    "default_title": "APEX SENTINEL",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/icon-128.png",
    "open_at_install": false
  },
  "side_panel": {
    "default_path": "sidebar/sidebar.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webNavigation",
    "cookies",
    "privacy",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "apex-sentinel@apexlifeglobal.com",
      "strict_min_version": "109.0"
    }
  }
}
