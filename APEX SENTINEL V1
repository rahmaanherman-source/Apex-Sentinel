// DeclarativeNetRequest rules generation placeholder
async function ensureDNRRules() {
  if (chrome.declarativeNetRequest && chrome.declarativeNetRequest.updateDynamicRules) {
    const rules = BLOCKLIST.map((d, i) => ({
      id: i+1, priority:1,
      action:{type:'block'},
      condition:{urlFilter:d, resourceTypes:['script','image','xmlhttprequest']}
    }));
    try {
      await chrome.declarativeNetRequest.updateDynamicRules({ addRules: rules, removeRuleIds: rules.map(r=>r.id) });
    } catch (e) { /* fallback handled below */ }
  }
}
ensureDNRRules();

// Safe cookie removal helper
async function safeRemoveCookie(cookie) {
  try {
    const domain = cookie.domain.replace(/^\./,'');
    const scheme = cookie.secure ? 'https' : 'http';
    const url = `${scheme}://${domain}${cookie.path || '/'}`;
    await chrome.cookies.remove({ url, name: cookie.name });
  } catch (e) { /* ignore non-critical errors */ }
}

// Listen for cookie changes and remove cross-site trackers only when user enabled
chrome.cookies.onChanged.addListener(async (changeInfo) => {
  const settings = await chrome.storage.local.get({ blockTrackers: false });
  if (!settings.blockTrackers) return;
  const cookie = changeInfo.cookie;
  try {
    const tabs = await chrome.tabs.query({ active: true, currentWindow: true });
    if (!tabs || !tabs[0] || !tabs[0].url) return;
    const currentDomain = new URL(tabs[0].url).hostname;
    if (cookie.domain && !currentDomain.includes(cookie.domain.replace(/^\./,''))) {
      await safeRemoveCookie(cookie);
      await addLog(`Removed cross-site cookie ${cookie.name} from ${cookie.domain}`);
    }
  } catch (e) { /* safe bypass */ }
});

// Message handler
chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  if (msg.type === 'CHECK_URL') {
    const blocked = BLOCKLIST.some(d => msg.url.includes(d));
    sendResponse({ blocked });
  } else if (msg.type === 'LOG') {
    addLog(msg.data);
    sendResponse({ ok: true });
  }
  return true;
});
export async function addLog(message) {
  const { activityLogs = [] } = await chrome.storage.local.get({ activityLogs: [] });
  activityLogs.unshift({ timestamp: new Date().toISOString(), log: message });
  if (activityLogs.length > 100) activityLogs.length = 100;
  await chrome.storage.local.set({ activityLogs });
}
